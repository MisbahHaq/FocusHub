rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // User profile document
      allow read, write: if isOwner(uid);

      // Items (topics / habits)
      match /items/{itemId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && (
            !('accumulatedSeconds' in request.resource.data)
            || (request.resource.data.accumulatedSeconds is number && request.resource.data.accumulatedSeconds >= 0)
          )
          && (
            !('isRunning' in request.resource.data)
            || request.resource.data.isRunning == false
            || (
              request.resource.data.isRunning == true
              && get(/databases/$(database)/documents/users/$(uid)/meta/activeTimer).data.itemId == itemId
            )
          );
      }

      // Session logs
      match /logs/{logId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && (
            !('seconds' in request.resource.data)
            || (request.resource.data.seconds is number && request.resource.data.seconds >= 0)
          );
      }

      // Notes workspace
      match /notes/{noteId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasAll(['title', 'body', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 500
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 100000;
        allow delete: if isOwner(uid);
      }

      // Seasons
      match /seasons/{seasonId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasAll(['title', 'startDate', 'endDate', 'durationWeeks'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.durationWeeks is number
          && request.resource.data.durationWeeks >= 1
          && request.resource.data.durationWeeks <= 26;
        allow delete: if isOwner(uid);
      }

      // Backlog entries
      match /backlog/{entryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasAll(['title', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 500;
        allow delete: if isOwner(uid);
      }

      // Daily energy mode logs
      match /dailyLogs/{logId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasAll(['task', 'energyType', 'timestamp', 'userId'])
          && request.resource.data.task is string
          && request.resource.data.task.size() <= 500
          && request.resource.data.energyType in ['production', 'consumption'];
        allow delete: if isOwner(uid);
      }

      // Habit completion logs
      match /habitLogs/{logId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasAll(['completed', 'date'])
          && request.resource.data.completed is bool;
        allow delete: if isOwner(uid);
      }

      // Metadata collection (activeTimer, settings, etc.)
      match /meta/{metaId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
